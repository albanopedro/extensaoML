{
  "manifest_version": 3,

  "name": "ML Metrics",
  "version": "0.1.0",
  "description": "Mostra metricas de desempenho em anuncios do Mercado Livre.",

  "permissions": ["storage"],

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ML Metrics"
  },

  "content_scripts": [
    {
      "matches": ["https://*.mercadolivre.com.br/*", "file:///*"],
      "js": ["src/coletor.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
